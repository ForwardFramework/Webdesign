# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env.local and fill in. NOTHING here is required to run the site —
#  it starts with clearly-labelled sample data and estimated drive times.
# ─────────────────────────────────────────────────────────────────────────────

# Production origin. Used for canonical URLs, sitemap.xml, OG tags and JSON-LD.
# Set this before launch or search engines will index the placeholder domain.
NEXT_PUBLIC_SITE_URL=https://www.lakewoodranchlivingfl.com


# ── MLS / IDX ────────────────────────────────────────────────────────────────
# Until one of these is configured the home search shows sample records behind a
# permanent "not real listings" banner. Stellar MLS offers two API routes and
# both need a three-party agreement between the broker, the vendor and Stellar
# MLS.  https://www.stellarmls.com/api-options
#
# Force a provider (mlsgrid | bridge | simplyrets | sample). Optional — the app
# auto-detects from whichever credentials are present.
# MLS_PROVIDER=mlsgrid

# Option 1 — MLS Grid (register at https://app.mlsgrid.com/register)
# MLSGRID_TOKEN=
# MLSGRID_ORIGINATING_SYSTEM=mfrmls

# Option 2 — Bridge Interactive (Zillow Group)
# BRIDGE_ACCESS_TOKEN=
# BRIDGE_DATASET=

# Option 3 — SimplyRETS, if the brokerage already subscribes
# SIMPLYRETS_USER=
# SIMPLYRETS_PASSWORD=


# ── Drive times ──────────────────────────────────────────────────────────────
# Without this, drive times are ESTIMATED from mapped distance and labelled with
# an asterisk everywhere they appear. With it, they become live and traffic-aware.
# Enable the Routes API in Google Cloud and restrict the key to your server IPs.
# GOOGLE_ROUTES_API_KEY=


# ── Lead delivery ────────────────────────────────────────────────────────────
# Pick ONE. Without either, leads are written to the server log only and the
# API response says so.
#
# A: POST the JSON anywhere — Zapier, Make, Follow Up Boss, kvCORE, a CRM webhook
# LEAD_WEBHOOK_URL=

# B: Email via Resend (https://resend.com)
# RESEND_API_KEY=
# LEAD_NOTIFY_EMAIL=caitlin@example.com
# LEAD_FROM_EMAIL=website@yourdomain.com


# ── Images ───────────────────────────────────────────────────────────────────
# Out of the box the site renders the generated images from their origin CDN.
# Before launch run `npm run fetch:images` to download them into
# public/images/generated, then set this to true so you serve your own assets.
# NEXT_PUBLIC_USE_LOCAL_IMAGES=true
