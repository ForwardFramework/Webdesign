# Copy to .env for local development, and set these in your host's
# environment-variable settings for production.

# Resend API key — https://resend.com/api-keys  (required for form delivery)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where leads are delivered. Defaults to info@topdogexteriors.com if unset.
LEAD_TO=info@topdogexteriors.com

# The From address. Must be on a domain verified in Resend.
LEAD_FROM="Top Dog Exteriors Website <website@topdogexteriors.com>"

# Optional second recipient, e.g. a CRM inbound address.
# LEAD_BCC=leads@yourcrm.example
