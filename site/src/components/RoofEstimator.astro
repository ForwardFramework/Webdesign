---
import Icon from './Icon.astro';
import { site } from '../data/site.ts';
import { MATERIALS, PITCH, COMPLEXITY, TEAROFF } from '../scripts/roof-estimate.ts';

/**
 * Instant roof estimate. Four steps, one screen at a time, price revealed BEFORE
 * the contact form rather than held hostage behind it — giving the homeowner
 * something before asking for anything is the entire reason these tools convert.
 */
const materialKeys = Object.keys(MATERIALS) as (keyof typeof MATERIALS)[];
---

<div class="est" id="roof-estimator" data-estimator>
  <!-- Progress -->
  <div class="est__progress" role="group" aria-label="Estimate progress">
    <ol class="est__steps">
      {
        ['Your home', 'Your roof', 'Your material', 'Your price'].map((label, i) => (
          <li class="est__step" data-step-indicator={i + 1} aria-current={i === 0 ? 'step' : undefined}>
            <span class="est__step-num">{i + 1}</span>
            <span class="est__step-label">{label}</span>
          </li>
        ))
      }
    </ol>
    <div class="est__bar"><span class="est__bar-fill" data-progress-fill style="width:25%"></span></div>
  </div>

  <div class="est__form" data-estimator-form>
    <!-- ── Step 1 — address & size ──────────────────────────────────────── -->
    <fieldset class="est__panel" data-panel="1">
      <div class="est__legend">
        <span class="eyebrow">Step 1 of 4</span>
        <h3>Where is the roof?</h3>
        <p>We use your address to pull your property and check that you are inside our service area.</p>
      </div>

      <div class="est__field est__field--full">
        <label for="est-address">Street address</label>
        <div class="est__addr">
          <Icon name="map-pin" size={20} class="est__addr-icon" />
          <input
            type="text" id="est-address" name="address" required
            autocomplete="street-address" placeholder="1200 Library Rd, Bethel Park, PA"
            aria-describedby="est-address-err"
          />
        </div>
        <p class="est__err" id="est-address-err" data-error-for="address" hidden></p>
      </div>

      <div class="est__row">
        <div class="est__field">
          <label for="est-sqft">Approximate living area (sq ft)</label>
          <input
            type="number" id="est-sqft" name="homeSqFt" required
            min="400" max="12000" step="50" value="1800" inputmode="numeric"
            aria-describedby="est-sqft-hint est-sqft-err"
          />
          <p class="est__hint" id="est-sqft-hint">Close is fine — check your tax record or a listing.</p>
          <p class="est__err" id="est-sqft-err" data-error-for="homeSqFt" hidden></p>
        </div>

        <div class="est__field">
          <span class="est__label" id="est-stories-label">Stories</span>
          <div class="est__chips" role="radiogroup" aria-labelledby="est-stories-label">
            {
              [
                { v: '1', l: '1' },
                { v: '1.5', l: '1½' },
                { v: '2', l: '2' },
                { v: '3', l: '3+' },
              ].map((o, i) => (
                <label class="est__chip">
                  <input type="radio" name="stories" value={o.v} checked={i === 2} />
                  <span>{o.l}</span>
                </label>
              ))
            }
          </div>
        </div>
      </div>

      <div class="est__nav">
        <button type="button" class="btn btn--primary btn--lg est__next" data-next>
          Next: your roof <Icon name="arrow_right" size={18} />
        </button>
      </div>
    </fieldset>

    <!-- ── Step 2 — pitch, complexity, layers ───────────────────────────── -->
    <fieldset class="est__panel" data-panel="2" hidden>
      <div class="est__legend">
        <span class="eyebrow">Step 2 of 4</span>
        <h3>Tell us about the roof itself</h3>
        <p>These three answers move the price more than anything else. Best guess is fine — we verify on the inspection.</p>
      </div>

      <div class="est__field est__field--full">
        <span class="est__label" id="est-pitch-label">How steep is it?</span>
        <div class="est__options" role="radiogroup" aria-labelledby="est-pitch-label">
          {
            Object.entries(PITCH).map(([key, v], i) => (
              <label class="est__option">
                <input type="radio" name="pitch" value={key} checked={i === 1} />
                <span class="est__option-body">
                  <span class="est__option-title">{v.label}</span>
                  <span class="est__option-hint">{v.hint}</span>
                </span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="est__field est__field--full">
        <span class="est__label" id="est-complexity-label">How cut up is it?</span>
        <div class="est__options est__options--3" role="radiogroup" aria-labelledby="est-complexity-label">
          {
            Object.entries(COMPLEXITY).map(([key, v], i) => (
              <label class="est__option">
                <input type="radio" name="complexity" value={key} checked={i === 1} />
                <span class="est__option-body">
                  <span class="est__option-title">{v.label}</span>
                  <span class="est__option-hint">{v.hint}</span>
                </span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="est__field est__field--full">
        <span class="est__label" id="est-layers-label">How many layers are up there now?</span>
        <div class="est__chips est__chips--wide" role="radiogroup" aria-labelledby="est-layers-label">
          {
            Object.entries(TEAROFF).map(([key, v], i) => (
              <label class="est__chip">
                <input type="radio" name="layers" value={key} checked={i === 0} />
                <span>{v.label}</span>
              </label>
            ))
          }
        </div>
        <p class="est__hint">Not sure? Choose one layer — we confirm it during the free inspection.</p>
      </div>

      <div class="est__nav">
        <button type="button" class="btn btn--outline" data-back>Back</button>
        <button type="button" class="btn btn--primary btn--lg est__next" data-next>
          Next: pick a material <Icon name="arrow_right" size={18} />
        </button>
      </div>
    </fieldset>

    <!-- ── Step 3 — material ────────────────────────────────────────────── -->
    <fieldset class="est__panel" data-panel="3" hidden>
      <div class="est__legend">
        <span class="eyebrow">Step 3 of 4</span>
        <h3>Which roofing system?</h3>
        <p>We install all five. Pick one to price — you can change it on the results screen and watch the number move.</p>
      </div>

      <div class="est__field est__field--full">
        <div class="est__materials" role="radiogroup" aria-label="Roofing system">
          {
            materialKeys.map((key, i) => (
              <label class="est__material">
                <input type="radio" name="material" value={key} checked={i === 0} />
                <span class="est__material-body">
                  <span class="est__material-head">
                    <span class="est__material-title">{MATERIALS[key].label}</span>
                    <span class="est__material-life">{MATERIALS[key].lifespan}</span>
                  </span>
                  <span class="est__material-blurb">{MATERIALS[key].blurb}</span>
                  <span class="est__material-warranty">
                    <Icon name="shield-check" size={14} /> {MATERIALS[key].warranty}
                  </span>
                </span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="est__nav">
        <button type="button" class="btn btn--outline" data-back>Back</button>
        <button type="button" class="btn btn--primary btn--lg est__next" data-next>
          <Icon name="calculator" size={19} /> Calculate my price
        </button>
      </div>
    </fieldset>

    <!-- ── Step 4 — result ──────────────────────────────────────────────── -->
    <fieldset class="est__panel" data-panel="4" hidden>
      <div class="est__scanning" data-scanning hidden aria-hidden="true">
        <div class="est__radar"><Icon name="satellite" size={34} /></div>
        <p data-scan-text>Locating your property…</p>
      </div>

      <div data-result hidden>
        <div class="est__legend est__legend--result">
          <span class="eyebrow">Your instant estimate</span>
          <h3>Here’s your price range</h3>
        </div>

        <div class="est__price">
          <p class="est__price-range">
            <span data-price-low>$0</span>
            <span class="est__price-dash" aria-hidden="true">–</span>
            <span data-price-high>$0</span>
          </p>
          <p class="est__price-meta">
            <span data-price-material>Architectural shingle</span> ·
            about <strong data-price-squares>0</strong> squares
            (<span data-price-sqft>0</span> sq ft of roof surface)
          </p>
          <p class="est__price-finance">
            or approximately <strong data-price-monthly>$0</strong>/month with approved financing
          </p>
        </div>

        <!-- Live material switcher: the single highest-engagement element here. -->
        <div class="est__switch">
          <span class="est__label" id="est-switch-label">Compare another system</span>
          <div class="est__switch-row" role="radiogroup" aria-labelledby="est-switch-label">
            {
              materialKeys.map((key, i) => (
                <label class="est__chip">
                  <input type="radio" name="materialSwitch" value={key} checked={i === 0} />
                  <span>{MATERIALS[key].short}</span>
                </label>
              ))
            }
          </div>
        </div>

        <p class="est__disclaimer">
          <Icon name="alert" size={16} />
          <span>
            This is a real budget range built from your inputs and current Pittsburgh installed
            pricing — not a contract. Decking condition, ventilation, chimney and skylight
            flashing, and permit costs are confirmed during your free on-roof inspection, and your
            final written proposal is line-itemed.
          </span>
        </p>

        <!-- Contact capture: after the value, never before it. -->
        <div class="est__capture">
          <h4>Lock this in with a free on-roof inspection</h4>
          <p>
            We measure by hand, photograph everything, and send you the full report — whether you
            hire us or not. Your instant estimate comes along with it.
          </p>

          <form
            class="est__lead"
            method="POST"
            action="/api/lead"
            novalidate
            data-lead-form
            id="estimator-lead"
            aria-describedby="estimator-lead-status"
          >
            <div class="est__hp" aria-hidden="true">
              <label for="est-company">Company</label>
              <input type="text" id="est-company" name="company" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="source" value="instant-roof-quote" />
            <input type="hidden" name="page" value="/instant-roof-quote" />
            <input type="hidden" name="service" value="Roofing" />
            <input type="hidden" name="rendered_at" data-rendered-at value="" />
            <input type="hidden" name="estimate_summary" data-estimate-summary value="" />

            <div class="est__lead-grid">
              <div class="est__field">
                <label for="est-name">Full name</label>
                <input type="text" id="est-name" name="name" required autocomplete="name" placeholder="Jane Miller" aria-describedby="est-name-err" />
                <p class="est__err" id="est-name-err" data-error-for="name" hidden></p>
              </div>
              <div class="est__field">
                <label for="est-phone">Phone</label>
                <input type="tel" id="est-phone" name="phone" required autocomplete="tel" inputmode="tel" placeholder="(412) 555-0134" aria-describedby="est-phone-err" />
                <p class="est__err" id="est-phone-err" data-error-for="phone" hidden></p>
              </div>
              <div class="est__field">
                <label for="est-email">Email</label>
                <input type="email" id="est-email" name="email" required autocomplete="email" inputmode="email" placeholder="jane@example.com" aria-describedby="est-email-err" />
                <p class="est__err" id="est-email-err" data-error-for="email" hidden></p>
              </div>
              <div class="est__field">
                <label for="est-zip">ZIP code</label>
                <input type="text" id="est-zip" name="zip" required autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="15102" aria-describedby="est-zip-err" />
                <p class="est__err" id="est-zip-err" data-error-for="zip" hidden></p>
              </div>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">
              <span data-submit-label>Book My Free Roof Inspection</span>
              <span class="qf__spinner" data-spinner hidden aria-hidden="true"></span>
            </button>

            <p class="est__lead-trust">
              <Icon name="shield-check" size={15} /> No obligation. No high-pressure visit. We never sell your information.
            </p>

            <div class="qf__status" id="estimator-lead-status" role="status" aria-live="polite" data-status hidden></div>
          </form>

          <p class="est__call">
            Prefer to talk it through? Call <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>.
          </p>
        </div>

        <div class="est__nav est__nav--result">
          <button type="button" class="btn btn--outline" data-back>Change my answers</button>
        </div>
      </div>
    </fieldset>
  </div>
</div>

<style>
  .est {
    background: #fff;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  /* ── Progress ───────────────────────────────────────────────────────── */
  .est__progress { padding: var(--sp-5) var(--sp-6) 0; background: var(--n-50); border-bottom: 1px solid var(--border); }
  .est__steps {
    list-style: none;
    margin: 0 0 var(--sp-4);
    padding: 0;
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .est__step { display: flex; align-items: center; gap: 0.5rem; }
  .est__step-num {
    width: 26px; height: 26px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--n-200);
    color: var(--n-600);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    transition: background var(--t), color var(--t);
  }
  .est__step-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--text-subtle);
    transition: color var(--t);
  }
  .est__step[data-state='active'] .est__step-num,
  .est__step[data-state='done'] .est__step-num { background: var(--brand-600); color: #fff; }
  .est__step[data-state='active'] .est__step-label { color: var(--n-900); }
  .est__step[data-state='done'] .est__step-label { color: var(--text-muted); }

  .est__bar { height: 4px; margin-bottom: 2px; background: var(--n-200); border-radius: 2px; overflow: hidden; }
  .est__bar-fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--brand-600), var(--brand-400));
    transition: width var(--t-slow);
  }

  /* ── Panels ─────────────────────────────────────────────────────────── */
  .est__panel {
    border: 0;
    margin: 0;
    padding: var(--sp-7) var(--sp-6);
    display: grid;
    gap: var(--sp-5);
  }
  .est__panel[hidden] { display: none; }

  .est__legend { padding: 0; display: block; width: 100%; }
  .est__legend h3 { font-size: var(--fs-xl); margin-bottom: var(--sp-2); }
  .est__legend p { color: var(--text-muted); font-size: var(--fs-sm); line-height: 1.6; max-width: 60ch; }
  .est__legend--result { text-align: center; }
  .est__legend--result p { margin-inline: auto; }

  .est__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--sp-5);
  }
  .est__field { display: flex; flex-direction: column; gap: 0.4rem; }
  .est__field--full { grid-column: 1 / -1; }

  .est label,
  .est__label {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--n-800);
  }
  .est__hint { font-size: 0.8rem; color: var(--text-subtle); }
  .est__err { font-size: 0.82rem; font-weight: 600; color: var(--danger-700); }
  .est__err[hidden] { display: none; }

  .est input[type='text'],
  .est input[type='tel'],
  .est input[type='email'],
  .est input[type='number'] {
    width: 100%;
    color: var(--text);
    min-height: 52px;
    padding: 0.7rem 0.9rem;
    font-size: 1rem;
    background: var(--n-50);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    transition: border-color var(--t-fast), background var(--t-fast), box-shadow var(--t-fast);
  }
  .est input::placeholder { color: var(--n-400); opacity: 1; }

  .est input:focus {
    outline: none;
    background: #fff;
    border-color: var(--brand-600);
    box-shadow: 0 0 0 3px rgba(194, 65, 12, 0.16);
  }
  .est [aria-invalid='true'] { border-color: var(--danger-700); background: var(--danger-50); }

  /* Honeypot — clipped rather than pushed off-screen with a negative offset,
     which would inflate documentElement.scrollWidth. */
  .est__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .est__addr { position: relative; }
  .est__addr input[type='text'] { padding-left: 2.9rem; }
  .est__addr-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--brand-600);
    pointer-events: none;
  }

  /* ── Chips ──────────────────────────────────────────────────────────── */
  .est__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .est__chip { position: relative; }
  .est__chip input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .est__chip span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 60px;
    padding: 0.55rem 1rem;
    background: var(--n-50);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--n-700);
    cursor: pointer;
    transition: all var(--t-fast);
  }
  .est__chip input:hover + span { border-color: var(--brand-500); }
  .est__chip input:checked + span {
    background: var(--brand-600);
    border-color: var(--brand-600);
    color: #fff;
  }
  .est__chip input:focus-visible + span { outline: 3px solid var(--ring); outline-offset: 2px; }
  .est__chips--wide .est__chip span { min-width: 130px; }

  /* ── Option cards ───────────────────────────────────────────────────── */
  .est__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 0.6rem;
  }
  .est__option { position: relative; display: flex; }
  .est__option input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .est__option-body {
    flex: 1;
    padding: 0.9rem 1rem;
    background: var(--n-50);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition: all var(--t-fast);
  }
  .est__option input:hover + .est__option-body { border-color: var(--brand-500); }
  .est__option input:checked + .est__option-body {
    background: var(--brand-50);
    border-color: var(--brand-600);
    box-shadow: inset 0 0 0 1px var(--brand-600);
  }
  .est__option input:focus-visible + .est__option-body { outline: 3px solid var(--ring); outline-offset: 2px; }
  .est__option-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--n-900);
  }
  .est__option-hint {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.79rem;
    line-height: 1.45;
    color: var(--text-subtle);
  }

  /* ── Material cards ─────────────────────────────────────────────────── */
  .est__materials { display: grid; gap: 0.6rem; }
  .est__material { position: relative; display: flex; }
  .est__material input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .est__material-body {
    flex: 1;
    padding: 1rem 1.1rem;
    background: var(--n-50);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition: all var(--t-fast);
  }
  .est__material input:hover + .est__material-body { border-color: var(--brand-500); }
  .est__material input:checked + .est__material-body {
    background: var(--brand-50);
    border-color: var(--brand-600);
    box-shadow: inset 0 0 0 1px var(--brand-600);
  }
  .est__material input:focus-visible + .est__material-body { outline: 3px solid var(--ring); outline-offset: 2px; }
  .est__material-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .est__material-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    color: var(--n-900);
  }
  .est__material-life {
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--n-200);
    color: var(--n-700);
  }
  .est__material input:checked + .est__material-body .est__material-life {
    background: var(--brand-600);
    color: #fff;
  }
  .est__material-blurb {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .est__material-warranty {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.45rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--success-700);
  }

  /* ── Navigation ─────────────────────────────────────────────────────── */
  .est__nav { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .est__next { flex: 1; min-width: 220px; }
  .est__nav--result { justify-content: center; margin-top: var(--sp-2); }

  /* ── Scanning animation ─────────────────────────────────────────────── */
  .est__scanning { display: grid; place-items: center; gap: var(--sp-4); padding: var(--sp-10) 0; text-align: center; }
  .est__scanning[hidden] { display: none; }
  .est__radar {
    width: 88px; height: 88px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand-600);
    position: relative;
  }
  .est__radar::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2px solid var(--brand-500);
    opacity: 0;
    animation: est-ping 1.6s ease-out infinite;
  }
  @keyframes est-ping {
    0% { transform: scale(0.85); opacity: 0.75; }
    100% { transform: scale(1.3); opacity: 0; }
  }
  .est__scanning p {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .est__radar::after { animation: none; opacity: 0.4; }
  }

  /* ── Price display ──────────────────────────────────────────────────── */
  .est__price {
    text-align: center;
    padding: var(--sp-6) var(--sp-5);
    background: linear-gradient(160deg, var(--steel-900), var(--n-900));
    border-radius: var(--radius-lg);
    color: var(--n-300);
  }
  .est__price-range {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 1rem + 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .est__price-dash { color: var(--brand-500); margin-inline: 0.3rem; }
  .est__price-meta { margin-top: var(--sp-3); font-size: 0.9rem; color: var(--n-400); }
  .est__price-meta strong { color: #fff; }
  .est__price-finance {
    display: inline-block;
    margin-top: var(--sp-4);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: rgba(234, 88, 12, 0.18);
    border: 1px solid rgba(234, 88, 12, 0.4);
    font-size: 0.87rem;
    color: var(--brand-100);
  }
  .est__price-finance strong { color: #fff; font-family: var(--font-display); }

  .est__switch { display: grid; gap: 0.6rem; }
  .est__switch-row { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .est__switch-row .est__chip span { min-height: 44px; font-size: 0.85rem; }

  .est__disclaimer {
    display: flex;
    gap: 0.6rem;
    padding: var(--sp-4);
    background: var(--n-50);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .est__disclaimer svg { color: var(--brand-600); flex: none; margin-top: 2px; }

  /* ── Capture ────────────────────────────────────────────────────────── */
  .est__capture {
    padding: var(--sp-6);
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-lg);
  }
  .est__capture h4 { font-size: var(--fs-lg); margin-bottom: var(--sp-2); }
  .est__capture > p { font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.6; margin-bottom: var(--sp-5); }
  .est__lead-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
  }
  .est__lead input { background: #fff; }
  .est__lead-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: var(--sp-3);
    font-size: 0.79rem;
    color: var(--text-subtle);
    text-align: center;
  }
  .est__lead-trust svg { color: var(--success-700); flex: none; }
  .est__call { margin-top: var(--sp-4); text-align: center; font-size: 0.85rem; color: var(--text-muted); }
  .est__call a { font-weight: 700; }

  @media (max-width: 620px) {
    .est__panel { padding: var(--sp-5) var(--sp-4); }
    .est__progress { padding: var(--sp-4) var(--sp-4) 0; }
    .est__steps { gap: var(--sp-3); }
    .est__step-label { display: none; }
    .est__capture { padding: var(--sp-4); }
    .est__next { min-width: 0; }
  }
</style>

<script>
  import { calculateEstimate, MATERIALS, money } from '../scripts/roof-estimate.ts';
  import type { EstimateInput, MaterialKey } from '../scripts/roof-estimate.ts';
  import { initLeadForm } from '../scripts/lead-form.ts';

  const root = document.querySelector<HTMLElement>('[data-estimator]');
  const wizard = root?.querySelector<HTMLElement>('[data-estimator-form]');
  if (root && wizard) {
    /* The wizard is a plain container, not a <form> — a <form> here would have
       swallowed the lead-capture <form> in step 4, since HTML forbids nesting
       them. So field lookups go through querySelector rather than form.elements,
       and they are scoped to the wizard so the lead form's own inputs (which
       share names like `name` and `zip`) can never be picked up by mistake. */
    const field = <T extends HTMLElement = HTMLInputElement>(name: string) =>
      wizard.querySelector<T>(`[name="${name}"]`);
    const panels = Array.from(root.querySelectorAll<HTMLFieldSetElement>('[data-panel]'));
    const indicators = Array.from(root.querySelectorAll<HTMLElement>('[data-step-indicator]'));
    const fill = root.querySelector<HTMLElement>('[data-progress-fill]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let step = 1;

    const paint = () => {
      panels.forEach((p) => (p.hidden = Number(p.dataset.panel) !== step));
      indicators.forEach((el) => {
        const n = Number(el.dataset.stepIndicator);
        el.dataset.state = n < step ? 'done' : n === step ? 'active' : 'todo';
        if (n === step) el.setAttribute('aria-current', 'step');
        else el.removeAttribute('aria-current');
      });
      if (fill) fill.style.width = `${(step / panels.length) * 100}%`;
    };

    const focusPanel = () => {
      const panel = panels.find((p) => Number(p.dataset.panel) === step);
      const heading = panel?.querySelector<HTMLElement>('h3');
      if (heading) {
        heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
      }
      root.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    };

    /* ── Per-step validation ─────────────────────────────────────────── */
    const setErr = (name: string, message: string | null) => {
      const box = wizard.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = field(name);
      if (message) {
        if (box) { box.textContent = message; box.hidden = false; }
        input?.setAttribute('aria-invalid', 'true');
      } else {
        if (box) { box.textContent = ''; box.hidden = true; }
        input?.removeAttribute('aria-invalid');
      }
    };

    const validateStep = (): boolean => {
      if (step !== 1) return true;
      let ok = true;
      const address = field('address')?.value.trim() ?? '';
      const sqft = Number(field('homeSqFt')?.value);

      if (address.length < 6) { setErr('address', 'Please enter your street address.'); ok = false; }
      else setErr('address', null);

      if (!Number.isFinite(sqft) || sqft < 400 || sqft > 12000) {
        setErr('homeSqFt', 'Enter a living area between 400 and 12,000 sq ft.');
        ok = false;
      } else setErr('homeSqFt', null);

      if (!ok) {
        wizard.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      }
      return ok;
    };

    /* ── Reading the form ────────────────────────────────────────────── */
    const readValue = (name: string) =>
      wizard.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';

    const readInput = (): EstimateInput => ({
      homeSqFt: Number(field('homeSqFt')?.value) || 1800,
      stories: Number(readValue('stories') || 2) as EstimateInput['stories'],
      pitch: (readValue('pitch') || 'medium') as EstimateInput['pitch'],
      complexity: (readValue('complexity') || 'moderate') as EstimateInput['complexity'],
      layers: (readValue('layers') || '1') as EstimateInput['layers'],
      material: (readValue('material') || 'architectural') as MaterialKey,
    });

    /* ── Rendering the result ────────────────────────────────────────── */
    const el = <T extends HTMLElement>(sel: string) => wizard.querySelector<T>(sel);

    const render = (material?: MaterialKey) => {
      const input = readInput();
      if (material) input.material = material;
      const result = calculateEstimate(input);

      el('[data-price-low]')!.textContent = money(result.low);
      el('[data-price-high]')!.textContent = money(result.high);
      el('[data-price-material]')!.textContent = result.material.short;
      el('[data-price-squares]')!.textContent = String(result.squares);
      el('[data-price-sqft]')!.textContent = result.roofSqFt.toLocaleString('en-US');
      el('[data-price-monthly]')!.textContent = `${money(result.monthlyLow)}–${money(result.monthlyHigh)}`;

      // Everything the estimator knows travels with the lead email.
      const address = field('address')?.value.trim() ?? '';
      const summary = [
        `Address: ${address}`,
        `Home: ${input.homeSqFt.toLocaleString('en-US')} sq ft, ${input.stories} stor${input.stories === 1 ? 'y' : 'ies'}`,
        `Roof: ${input.pitch} pitch, ${input.complexity} complexity, ${input.layers} existing layer(s)`,
        `System: ${result.material.label}`,
        `Measured roof area: ~${result.roofSqFt.toLocaleString('en-US')} sq ft (${result.squares} squares)`,
        `Instant estimate: ${money(result.low)} – ${money(result.high)}`,
      ].join('\n');
      const hidden = el<HTMLInputElement>('[data-estimate-summary]');
      if (hidden) hidden.value = summary;
    };

    /* ── The satellite-scan beat ─────────────────────────────────────── */
    const runScan = async () => {
      const scanning = el('[data-scanning]');
      const result = el('[data-result]');
      const text = el('[data-scan-text]');
      if (!scanning || !result) return;

      if (reduceMotion) {
        scanning.hidden = true;
        result.hidden = false;
        render();
        focusPanel();
        return;
      }

      scanning.hidden = false;
      result.hidden = true;

      const beats = ['Locating your property…', 'Measuring roof planes…', 'Pricing your system…'];
      for (const beat of beats) {
        if (text) text.textContent = beat;
        await new Promise((r) => setTimeout(r, 620));
      }

      scanning.hidden = true;
      result.hidden = false;
      render();
      focusPanel();
    };

    /* ── Wiring ──────────────────────────────────────────────────────── */
    wizard.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((btn) =>
      btn.addEventListener('click', () => {
        if (!validateStep()) return;
        step = Math.min(step + 1, panels.length);
        paint();
        if (step === panels.length) {
          // Mirror step 3's choice into the results switcher.
          const chosen = readValue('material');
          const mirror = wizard.querySelector<HTMLInputElement>(`input[name="materialSwitch"][value="${chosen}"]`);
          if (mirror) mirror.checked = true;
          void runScan();
        } else {
          focusPanel();
        }
      })
    );

    wizard.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((btn) =>
      btn.addEventListener('click', () => {
        step = Math.max(step - 1, 1);
        paint();
        focusPanel();
      })
    );

    // Live re-price when the homeowner compares systems on the results screen.
    wizard.querySelectorAll<HTMLInputElement>('input[name="materialSwitch"]').forEach((radio) =>
      radio.addEventListener('change', () => {
        const value = radio.value as MaterialKey;
        const source = wizard.querySelector<HTMLInputElement>(`input[name="material"][value="${value}"]`);
        if (source) source.checked = true;
        render(value);
      })
    );

    // Enter advances a step. The lead form in step 4 keeps its own behaviour.
    wizard.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const target = e.target as HTMLElement;
      if (target.tagName === 'TEXTAREA' || target.closest('[data-lead-form]')) return;
      e.preventDefault();
      const panel = panels.find((p) => Number(p.dataset.panel) === step);
      panel?.querySelector<HTMLButtonElement>('[data-next]')?.click();
    });

    // Guard against a stale material key sneaking through from a cached form.
    if (!(readValue('material') in MATERIALS)) {
      const first = wizard.querySelector<HTMLInputElement>('input[name="material"]');
      if (first) first.checked = true;
    }

    paint();
    initLeadForm();
  }
</script>
