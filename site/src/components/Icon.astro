  badge: '<circle cx="12" cy="9" r="6"/><path d="m8.5 14-1.5 8 5-3 5 3-1.5-8"/>',
  document: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M9 14h6"/><path d="M9 17h4"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0 5 5l-9.6 9.6a2.1 2.1 0 0 1-3-3Z"/><path d="m19.7 11.3 1.4-1.4a5 5 0 0 0-6.3-6.3l-1.4 1.4"/>',

  /* UI */
