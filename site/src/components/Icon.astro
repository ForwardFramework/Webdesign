---
/**
 * Inline SVG icon set. Everything is a stroked 24×24 path so icons stay crisp at
 * any size and inherit `currentColor`. No icon font, no sprite request, no emoji.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  /** Icons that carry meaning need a label; decorative ones stay aria-hidden. */
  label?: string;
  stroke?: number;
}

/* Astro passes the parent's `data-astro-cid-*` scope marker in as a prop.
   Spreading `rest` onto the root <svg> is what makes a parent's scoped rules
   (`.card svg { ... }`, or a class passed through `class=`) actually apply. */
