  concrete: '<path d="M3 20h18"/><path d="M5 20v-6h14v6"/><path d="M8 14V9a4 4 0 0 1 8 0v5"/><path d="M12 4v1"/>',
  addition: '<path d="M3 21V10l7-5 7 5"/><path d="M17 21V9h4v12"/><path d="M3 21h18"/><path d="M8 21v-5h4v5"/>',
  paint: '<path d="M19 3H5a2 2 0 0 0-2 2v4h18V5a2 2 0 0 0-2-2Z"/><path d="M14 9v3a2 2 0 0 1-2 2h-1v3"/><rect x="9" y="17" width="4" height="5" rx="1"/>',

  /* Trust & credential */
  'shield-check': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  star: '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/>',
