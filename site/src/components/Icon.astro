  satellite: '<path d="m7 12-4-4 4-4 4 4Z"/><path d="m17 12 4 4-4 4-4-4Z"/><path d="M9 10 14 15"/><path d="M14 5a5 5 0 0 1 5 5"/><path d="M14 1a9 9 0 0 1 9 9"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>',
  truck: '<path d="M2 17V7a1 1 0 0 1 1-1h11v11"/><path d="M14 9h4l3 4v4h-3"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>',
