---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 *  TOP DOG EXTERIORS — LOGO MARK
 * ─────────────────────────────────────────────────────────────────────────────
 *
 *  House skeleton with a circular badge holding the doodle portrait, redrawn as
 *  vector from the supplied artwork.
 *
 *  Two colour roles, so one path set serves every context:
 *    • `currentColor` — the house and the filled badge. Set it on the parent.
 *    • `--logo-paper` — the knockout: the badge ring and the dog's line work.
 *      Set it to whatever the mark is sitting on.
 *
 *  So: brand blue on white pages, white on navy sections, no second file.
 *
 *  ⚠ REPLACING THIS WITH THE OFFICIAL VECTOR
 *  This is a redraw, not the original file. If you have the logo as .ai/.eps/
 *  .svg from whoever designed it, export two SVGs — one all-blue, one all-white,
 *  both on transparent — drop them in `public/` as `logo.svg` / `logo-white.svg`,
 *  and swap the markup below for an <img>. Nothing else needs to change.
 */
interface Props {
  size?: number;
  class?: string;
  /** Colour of the badge ring and the dog line work. */
  paper?: string;
}
const { size = 44, class: className = '', paper = '#ffffff' } = Astro.props;
---

<svg
  viewBox="0 0 260 208"
  width={(size * 260) / 208}
  height={size}
  class={className}
  fill="none"
  aria-hidden="true"
  focusable="false"
  style={`--logo-paper:${paper}`}
>
  <!-- ── House ─────────────────────────────────────────────────────────────
       A skeleton, matching the artwork: thick chevron for the roof, thin bars
       for the walls and floor, gable interior left open. -->
  <g fill="currentColor">
    <!-- Chimney first, so the roof band overlaps its base -->
    <path d="M172 26h18a5 5 0 0 1 5 5v37h-23V26Z" />

    <!-- Roof: outer chevron minus inner chevron -->
    <path d="M130 10 252 88h-30.5L130 30.5 38.5 88H8L130 10Z" />

    <!-- Walls -->
    <rect x="52" y="80" width="17" height="116" />
    <rect x="191" y="80" width="17" height="116" />

    <!-- Floor course -->
    <rect x="52" y="179" width="156" height="17" />

    <!-- Gable window, four panes, sitting clear of the badge below -->
    <rect x="117" y="42" width="11" height="11" rx="2.5" />
    <rect x="132" y="42" width="11" height="11" rx="2.5" />
    <rect x="117" y="57" width="11" height="11" rx="2.5" />
    <rect x="132" y="57" width="11" height="11" rx="2.5" />
  </g>

  <!-- ── Badge ─────────────────────────────────────────────────────────── -->
  <circle cx="130" cy="140" r="59" fill="currentColor" />
  <circle cx="130" cy="140" r="53" fill="none" stroke="var(--logo-paper)" stroke-width="2.6" />

  <!-- ── Doodle portrait ───────────────────────────────────────────────────
       Line work is authored around (100,110); the transform seats it inside the
       badge, so the drawing itself stays easy to edit in isolation. -->
  <g
    transform="translate(130 140) scale(1.06) translate(-100 -110)"
    stroke="var(--logo-paper)"
    stroke-width="2.1"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  >
    <!-- Left ear: long, curly, hanging past the jaw -->
    <path d="M70 88c-7-2-13 1-15 7s0 11-2 16 -4 10-1 15 9 7 14 5 8-7 9-13" />
    <path d="M62 97c-4 3-5 8-3 12" />
    <path d="M58 112c-3 3-3 8-1 11" />

    <!-- Right ear -->
    <path d="M130 88c7-2 13 1 15 7s0 11 2 16 4 10 1 15 -9 7-14 5-8-7-9-13" />
    <path d="M138 97c4 3 5 8 3 12" />
    <path d="M142 112c3 3 3 8 1 11" />

    <!-- Topknot: curls over the crown -->
    <path d="M88 74c-1-5 2-9 6-10" />
    <path d="M100 62c-4-1-7 2-7 6" />
    <path d="M112 74c1-5-2-9-6-10" />
    <path d="M100 62c4-1 7 2 7 6" />

    <!-- Head outline: scalloped fur from crown down around the cheeks -->
    <path
      d="M94 65c-6 0-10 3-12 8 -6 0-10 4-10 9 -5 2-7 7-5 12
         -4 3-5 8-2 12 -3 4-2 9 2 12 -2 5 1 10 6 11
         -1 5 3 9 8 9 1 5 6 8 11 6 3 4 9 4 12 1
         3 3 9 3 12-1 5 2 10-1 11-6 5 0 9-4 8-9
         5-1 8-6 6-11 4-3 5-8 2-12 3-4 2-9-2-12
         2-5 0-10-5-12 0-5-4-9-10-9 -2-5-6-8-12-8"
    />

    <!-- Brow tufts -->
    <path d="M84 96c3-2 7-2 10 0" />
    <path d="M106 96c3-2 7-2 10 0" />

    <!-- Eyes -->
    <circle cx="87" cy="106" r="4.6" fill="var(--logo-paper)" stroke="none" />
    <circle cx="113" cy="106" r="4.6" fill="var(--logo-paper)" stroke="none" />

    <!-- Muzzle bridge -->
    <path d="M95 114c2 3 8 3 10 0" />

    <!-- Nose -->
    <path
      d="M92.5 121c0-3 3.5-4.5 7.5-4.5s7.5 1.5 7.5 4.5c0 3.5-4 6.5-7.5 6.5s-7.5-3-7.5-6.5Z"
      fill="var(--logo-paper)"
      stroke="none"
    />

    <!-- Tongue -->
    <path d="M100 129v4" />
    <path d="M95 133c2 4 8 4 10 0 -1-2-9-2-10 0Z" fill="var(--logo-paper)" stroke="none" />

    <!-- Beard -->
    <path d="M86 128c-2 4-1 8 2 10" />
    <path d="M114 128c2 4 1 8-2 10" />
    <path d="M92 142c3 3 13 3 16 0" />
  </g>
</svg>
