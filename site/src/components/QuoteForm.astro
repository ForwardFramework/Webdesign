---
import Icon from './Icon.astro';
import { site } from '../data/site.ts';
import { allServices } from '../data/services.ts';

interface Props {
  id?: string;
  heading?: string;
  sub?: string;
  /** Pre-selects the service dropdown on service landing pages. */
  service?: string;
  /** Hidden field so the email says where the lead came from. */
  source?: string;
  compact?: boolean;
  submitLabel?: string;
}

const {
  id = 'quote-form',
  heading = 'Get Your Free Estimate',
  sub = 'Tell us what you need. We reply within one business day — usually a lot sooner.',
  service = '',
  source = 'site',
  compact = false,
  submitLabel = 'Get My Free Estimate',
} = Astro.props;
---

<div class="qf" data-compact={compact ? 'true' : 'false'}>
  <div class="qf__head">
    <h2 class="qf__title">{heading}</h2>
    <p class="qf__sub">{sub}</p>
  </div>

  <form
    class="qf__form"
    id={id}
    method="POST"
    action="/api/lead"
    novalidate
    data-lead-form
    aria-describedby={`${id}-status`}
  >
    <!-- Honeypot: bots fill it, humans never see it. -->
    <div class="qf__hp" aria-hidden="true">
      <label for={`${id}-company`}>Company (leave blank)</label>
      <input type="text" id={`${id}-company`} name="company" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="source" value={source} />
    <input type="hidden" name="page" value={Astro.url.pathname} />
    <!-- Time-to-submit trap: a form completed in under 3s is not a human. -->
    <input type="hidden" name="rendered_at" data-rendered-at value="" />

    <div class="qf__grid">
      <div class="qf__field">
        <label for={`${id}-name`}>Full name <span class="qf__req" aria-hidden="true">*</span></label>
        <input
          type="text" id={`${id}-name`} name="name" required
          autocomplete="name" placeholder="Jane Miller"
          aria-describedby={`${id}-name-err`}
        />
        <p class="qf__err" id={`${id}-name-err`} data-error-for="name" hidden></p>
      </div>

      <div class="qf__field">
        <label for={`${id}-phone`}>Phone <span class="qf__req" aria-hidden="true">*</span></label>
        <input
          type="tel" id={`${id}-phone`} name="phone" required
          autocomplete="tel" inputmode="tel" placeholder="(412) 555-0134"
          aria-describedby={`${id}-phone-err`}
        />
        <p class="qf__err" id={`${id}-phone-err`} data-error-for="phone" hidden></p>
      </div>

      <div class="qf__field">
        <label for={`${id}-email`}>Email <span class="qf__req" aria-hidden="true">*</span></label>
        <input
          type="email" id={`${id}-email`} name="email" required
          autocomplete="email" inputmode="email" placeholder="jane@example.com"
          aria-describedby={`${id}-email-err`}
        />
        <p class="qf__err" id={`${id}-email-err`} data-error-for="email" hidden></p>
      </div>

      <div class="qf__field">
        <label for={`${id}-zip`}>Project ZIP code <span class="qf__req" aria-hidden="true">*</span></label>
        <input
          type="text" id={`${id}-zip`} name="zip" required
          autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}"
          maxlength="5" placeholder="15102"
          aria-describedby={`${id}-zip-err`}
        />
        <p class="qf__err" id={`${id}-zip-err`} data-error-for="zip" hidden></p>
      </div>

      <div class="qf__field qf__field--full">
        <label for={`${id}-service`}>What can we help with? <span class="qf__req" aria-hidden="true">*</span></label>
        <div class="qf__select">
          <select id={`${id}-service`} name="service" required aria-describedby={`${id}-service-err`}>
            <option value="" selected={!service}>Choose a service…</option>
            {allServices.map((s) => (
              <option value={s.name} selected={service === s.slug}>{s.name}</option>
            ))}
            <option value="Equipment Rental" selected={service === 'equipment-rental'}>Bobcat / Excavator Rental</option>
            <option value="Multiple Services" selected={service === 'bundle'}>Multiple services</option>
            <option value="Something else" selected={service === 'other'}>Something else</option>
          </select>
          <Icon name="chevron-down" size={18} class="qf__select-caret" />
        </div>
        <p class="qf__err" id={`${id}-service-err`} data-error-for="service" hidden></p>
      </div>

      <div class="qf__field qf__field--full">
        <label for={`${id}-message`}>Project details <span class="qf__opt">(optional)</span></label>
        <textarea
          id={`${id}-message`} name="message" rows="3"
          placeholder="Age of the roof, size of the deck, what you're trying to solve — anything helps us quote accurately."
        ></textarea>
      </div>

      <div class="qf__field qf__field--full qf__consent">
        <input type="checkbox" id={`${id}-consent`} name="consent" value="yes" />
        <label for={`${id}-consent`}>
          Text me updates about my estimate. Message and data rates may apply; reply STOP to opt out.
        </label>
      </div>
    </div>

    <button type="submit" class="btn btn--primary btn--lg btn--block qf__submit">
      <span data-submit-label>{submitLabel}</span>
      <span class="qf__spinner" data-spinner hidden aria-hidden="true"></span>
    </button>

    <p class="qf__trust">
      <Icon name="shield-check" size={16} />
      No obligation, no high-pressure sales visit. We never sell your information.
    </p>

    <!-- Single live region: announces both errors and success to screen readers. -->
    <div class="qf__status" id={`${id}-status`} role="status" aria-live="polite" data-status hidden></div>

    <noscript>
      <p class="qf__noscript">
        JavaScript is off, so this form will submit the ordinary way — you will land on a
        confirmation page. You can also email us directly at
        <a href={`mailto:${site.email}`}>{site.email}</a> or call
        <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>.
      </p>
    </noscript>
  </form>
</div>

<style>
  .qf {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--sp-6);
    box-shadow: var(--shadow-lg);
  }
  .qf[data-compact='true'] { padding: var(--sp-5); box-shadow: var(--shadow); }

  .qf__head { margin-bottom: var(--sp-5); }
  .qf__title {
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .qf__sub {
    margin-top: var(--sp-2);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  /* Off-screen via clipping rather than a negative offset — `left: -9999px`
     counts toward documentElement.scrollWidth and caused a 10px horizontal
     overflow at narrow widths. */
  .qf__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .qf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }
  .qf__field { display: flex; flex-direction: column; gap: 0.35rem; }
  .qf__field--full { grid-column: 1 / -1; }

  .qf label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--n-800);
  }
  .qf__req { color: var(--brand-600); }
  .qf__opt { font-weight: 500; color: var(--text-subtle); }

  .qf input[type='text'],
  .qf input[type='tel'],
  .qf input[type='email'],
  .qf select,
  .qf textarea {
    width: 100%;
    min-height: 50px;
    padding: 0.7rem 0.9rem;
    font-size: 1rem;
    color: var(--text);
    background: var(--n-50);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    transition: border-color var(--t-fast), background var(--t-fast), box-shadow var(--t-fast);
  }
  .qf textarea { min-height: 92px; resize: vertical; line-height: 1.55; }

  .qf input::placeholder,
  .qf textarea::placeholder { color: var(--n-400); }

  .qf input:focus,
  .qf select:focus,
  .qf textarea:focus {
    outline: none;
    background: #fff;
    border-color: var(--brand-600);
    box-shadow: 0 0 0 3px rgba(8, 115, 176, 0.18);
  }

  .qf [aria-invalid='true'] {
    border-color: var(--danger-700);
    background: var(--danger-50);
  }

  .qf__select { position: relative; }
  .qf__select select {
    appearance: none;
    padding-right: 2.6rem;
    cursor: pointer;
  }
  .qf__select-caret {
    position: absolute;
    right: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--n-500);
  }

  .qf__err {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--danger-700);
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .qf__err[hidden] { display: none; }

  .qf__consent {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.75rem;
    background: var(--n-50);
    border-radius: var(--radius);
  }
  .qf__consent input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    flex: none;
    accent-color: var(--brand-600);
    cursor: pointer;
  }
  .qf__consent label {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-muted);
    cursor: pointer;
  }

  .qf__submit { margin-top: var(--sp-5); }
  .qf__submit[disabled] { opacity: 0.72; cursor: progress; }

  .qf__spinner {
    width: 18px;
    height: 18px;
    border: 2.5px solid rgba(255, 255, 255, 0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: qf-spin 700ms linear infinite;
  }
  .qf__spinner[hidden] { display: none; }
  @keyframes qf-spin { to { transform: rotate(360deg); } }

  .qf__trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: var(--sp-3);
    font-size: 0.8rem;
    color: var(--text-subtle);
    text-align: center;
  }
  .qf__trust svg { color: var(--success-700); flex: none; }

  .qf__status {
    margin-top: var(--sp-4);
    padding: var(--sp-4);
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .qf__status[hidden] { display: none; }
  .qf__status[data-tone='success'] {
    background: var(--success-50);
    border: 1px solid #bbf7d0;
    color: #14532d;
  }
  .qf__status[data-tone='error'] {
    background: var(--danger-50);
    border: 1px solid #fecaca;
    color: #7f1d1d;
  }
  .qf__status strong { display: block; font-family: var(--font-display); margin-bottom: 0.2rem; }

  .qf__noscript {
    margin-top: var(--sp-4);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 620px) {
    .qf { padding: var(--sp-5); }
    .qf__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initLeadForm } from '../scripts/lead-form.ts';
  initLeadForm();
</script>
