---
/**
 * The official Top Dog Exteriors lockup.
 *
 * Assets are derived from `brand/TDE_Logo.jpg` by `gen-assets.mjs`, which keys
 * out the solid brand-blue ground and re-tints the artwork. Two colourways,
 * both on transparency:
 *
 *   tone="brand" → #38b6ff artwork, for white pages (the header)
 *   tone="light" → white artwork, for navy sections (the footer, the drawer)
 *
 * The source artwork stacks the mark above the wordmark. At header sizes that
 * would render the wordmark unreadably small, so the two are split into
 * separate files and set side by side here — the real house, the real dog, the
 * real typeface, just laid out horizontally.
 *
 * To update the logo: replace `brand/TDE_Logo.jpg` and re-run
 * `node gen-assets.mjs`. Nothing in the components needs to change.
 */
interface Props {
  tone?: 'brand' | 'light';
  /** Drop the wordmark — used where horizontal space is tight. */
  markOnly?: boolean;
  /** Drop the wordmark automatically on small screens (the header). */
  responsive?: boolean;
  /** Height of the mark in px. The wordmark scales with it. */
  size?: number;
}
const { tone = 'brand', markOnly = false, responsive = false, size = 46 } = Astro.props;
const suffix = tone === 'light' ? 'white' : 'blue';
---

<span
  class="logo"
  style={`--mark-h:${size}px`}
  data-mark-only={markOnly ? 'true' : 'false'}
  data-responsive={responsive ? 'true' : 'false'}
>
  <img
    class="logo__mark"
    src={`/brand/mark-${suffix}.png`}
    alt=""
    width="512"
    height="497"
    decoding="async"
  />
  <img
    class="logo__word"
    src={`/brand/word-${suffix}.png`}
    alt="Top Dog Exteriors"
    width="1116"
    height="83"
    decoding="async"
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    line-height: 1;
  }

  .logo__mark {
    height: var(--mark-h);
    width: auto;
    flex: none;
  }

  /* The wordmark is a long, short strip; tying it to the mark height keeps the
     lockup proportional at every size without hard-coding a width. */
  .logo__word {
    height: calc(var(--mark-h) * 0.38);
    width: auto;
    flex: none;
  }

  .logo[data-mark-only='true'] .logo__word { display: none; }

  /* The wordmark is ~13x wider than it is tall. Beside a phone button and a
     burger there is not room for it under ~560px, so the mark carries the brand
     there instead of the lockup overflowing the viewport. */
  .logo[data-responsive='true'] {
    --mark-h: 42px;
  }
  @media (max-width: 560px) {
    .logo[data-responsive='true'] .logo__word { display: none; }
    .logo[data-responsive='true'] { --mark-h: 40px; }
  }
</style>
