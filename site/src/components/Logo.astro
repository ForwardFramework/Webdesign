---
import LogoMark from './LogoMark.astro';

/**
 * Full lockup: mark + "TOP DOG EXTERIORS" wordmark.
 *
 * `tone="brand"` renders the mark in #38b6ff on a light page (the header).
 * `tone="light"` renders it in white for navy sections (the footer).
 * `markOnly` drops the wordmark for tight spaces.
 */
interface Props {
  tone?: 'brand' | 'light';
  markOnly?: boolean;
  size?: number;
}
const { tone = 'brand', markOnly = false, size = 42 } = Astro.props;
---

<span class="logo" data-tone={tone} data-mark-only={markOnly ? 'true' : 'false'}>
  <LogoMark size={size} paper={tone === 'light' ? 'var(--n-950)' : '#ffffff'} class="logo__mark" />
  <span class="logo__type">
    <span class="logo__word">TOP DOG</span>
    <span class="logo__sub">EXTERIORS</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    text-decoration: none;
    line-height: 1;
  }

  /* The mark inherits colour; the wordmark splits weight the way the original
     artwork does — "TOP DOG" heavy, "EXTERIORS" light and letterspaced. */
  .logo[data-tone='brand'] { color: var(--brand-400); }
  .logo[data-tone='brand'] .logo__word { color: var(--n-900); }
  .logo[data-tone='brand'] .logo__sub { color: var(--n-600); }

  .logo[data-tone='light'] { color: #fff; }
  .logo[data-tone='light'] .logo__word { color: #fff; }
  .logo[data-tone='light'] .logo__sub { color: rgba(255, 255, 255, 0.72); }

  .logo__mark { flex: none; }

  .logo__type {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.24rem;
    letter-spacing: -0.015em;
  }
  .logo__sub {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.6rem;
    letter-spacing: 0.28em;
  }

  .logo[data-mark-only='true'] .logo__type { display: none; }

  @media (max-width: 400px) {
    .logo { gap: 0.45rem; }
    .logo__word { font-size: 1.06rem; }
    .logo__sub { font-size: 0.53rem; letter-spacing: 0.2em; }
  }
</style>
