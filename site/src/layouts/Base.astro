---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { site } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/services/roofing". Defaults to current URL. */
  canonical?: string;
  ogImage?: string;
  /** Extra JSON-LD nodes merged into the page-level @graph. */
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
  noindex?: boolean;
  /** Set false on the instant-quote page so the sticky bar cannot cover the tool. */
  stickyCta?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  schema = [],
  breadcrumbs = [],
  noindex = false,
  stickyCta = true,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site.domain).href.replace(/\/$/, '') || site.domain;
const ogUrl = new URL(ogImage, site.domain).href;

/* ── Organisation node ─────────────────────────────────────────────────────
   Typed as RoofingContractor + HomeAndConstructionBusiness so both Google's
   local pack and LLM retrievers resolve the entity to the right category.      */
const organization = {
  '@type': ['RoofingContractor', 'HomeAndConstructionBusiness', 'LocalBusiness'],
  '@id': `${site.domain}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: site.domain,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  founder: { '@type': 'Person', name: site.owner },
  foundingDate: site.founded,
  priceRange: '$$',
  currenciesAccepted: 'USD',
  paymentAccepted: 'Cash, Check, Credit Card, Financing',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Allegheny County, Pennsylvania' },
    { '@type': 'AdministrativeArea', name: 'Washington County, Pennsylvania' },
    { '@type': 'AdministrativeArea', name: 'Butler County, Pennsylvania' },
    { '@type': 'City', name: 'Pittsburgh' },
  ],
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
    /* About an hour's drive from Pittsburgh. Stated in metres, as schema.org
       requires, and kept consistent with the "within about an hour" wording
       used in the page copy. */
    geoRadius: '65000',
  },
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.open,
    closes: h.close,
  })),
  sameAs: [site.social.facebook, site.social.instagram, site.social.bbb, site.social.nextdoor],
  hasCredential: site.credentials.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.label,
    description: c.detail,
  })),
  knowsAbout: [
    'asphalt shingle roof replacement',
    'standing seam metal roofing',
    'exposed fastener metal roofing',
    'TPO roofing',
    'EPDM rubber roofing',
    'TimberTech composite decking',
    'Trex composite decking',
    'James Hardie fiber cement siding',
    'LP SmartSide engineered wood siding',
    'Alside ASCEND composite cladding',
    'Everlast composite siding',
    'Alside Mezzo replacement windows',
    'Alside Vero replacement windows',
    'ProVia entry doors',
    'seamless aluminum gutters',
    'concrete driveways and flatwork',
    'excavation and site work',
    'home additions',
    'Hover 3D home visualisation',
    'Roofr instant roof estimates',
  ],
  logo: { '@type': 'ImageObject', url: `${site.domain}/logo.png`, width: 512, height: 512 },
  image: ogUrl,
};

const website = {
  '@type': 'WebSite',
  '@id': `${site.domain}/#website`,
  url: site.domain,
  name: site.name,
  publisher: { '@id': `${site.domain}/#organization` },
  inLanguage: 'en-US',
};

const breadcrumbNode =
  breadcrumbs.length > 0
    ? [{
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(b.href, site.domain).href,
        })),
      }]
    : [];

const graph = { '@context': 'https://schema.org', '@graph': [organization, website, ...breadcrumbNode, ...schema] };
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <!-- Geo signals: still read by several local-search crawlers and cheap to include -->
    <meta name="geo.region" content="US-PA" />
    <meta name="geo.placename" content={`${site.address.city}, Pennsylvania`} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="author" content={site.legalName} />
    <meta name="theme-color" content="#38b6ff" />
    <meta name="format-detection" content="telephone=yes" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

    <!--
      Opt in to the reveal animation before the first paint.

      This has to be inline and in <head>: it runs synchronously, so the class
      is on the element before anything is painted and there is no flash of
      un-animated content. It also has to be tiny and unconditional, because
      everything it enables is decorative — if it does not run, the stylesheet
      simply never hides anything and the page renders in full.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.setAttribute('data-reveal', 'on');
        // If the reveal script never gets to run at all — bundle blocked by an
        // extension, a 404, a CSP rule, a dead network — nothing would ever
        // remove the hiding. Stop hiding after five seconds unless that script
        // has checked in. Content outlives decoration.
        setTimeout(function () {
          if (!root.hasAttribute('data-reveal-ready')) root.removeAttribute('data-reveal');
        }, 5000);
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {stickyCta && <StickyCta />}

    <script>
      /*
        Scroll reveal.

        The hiding is opt-in: nothing is hidden until the inline <head> script
        has stamped data-reveal="on". By the time this runs, the only job left
        is to reveal — and every path below ends in everything being visible.

        The previous version hid content in the base stylesheet and revealed it
        from here. Anything that stopped this script — or an element the
        observer simply never reported — left a permanently blank white page
        that only a refresh fixed.
      */
      const root = document.documentElement;
      const pending = () => document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
      const showAll = () => pending().forEach((el) => el.classList.add('is-visible'));

      /* Tell the <head> guard that this script is alive, so it stops counting
         down to disabling the animation wholesale. */
      root.setAttribute('data-reveal-ready', '');

      /* The safety net is armed FIRST, before a single line that could throw.
         Registering it after the observer setup would mean an exception in that
         setup takes the net down with it — which is how content ends up hidden
         forever. */
      const failsafe = window.setTimeout(showAll, 4000);

      try {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          window.clearTimeout(failsafe);
          showAll();
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                const delay = Number(el.dataset.revealDelay ?? 0);
                window.setTimeout(() => el.classList.add('is-visible'), delay);
                io.unobserve(el);
              });
            },
            /* threshold 0 fires as soon as one pixel crosses the line. A
               fractional threshold can never be met by an element taller than
               the viewport, and is easily skipped past during fast scrolling —
               that is what left whole pages blank before. */
            { rootMargin: '0px 0px -10% 0px', threshold: 0 }
          );
          pending().forEach((el) => io.observe(el));

          /* Restoring from the back/forward cache re-runs no scripts, so
             anything mid-flight when the visitor navigated away stays hidden. */
          window.addEventListener('pageshow', (e) => {
            if ((e as PageTransitionEvent).persisted) showAll();
          });

          /* Printing, or deep-linking to an anchor, must never land on
             invisible content. */
          window.addEventListener('beforeprint', showAll);
          if (location.hash) showAll();
        }
      } catch {
        /* No IntersectionObserver, a hostile extension, anything at all:
           give up on the animation rather than on the content. */
        window.clearTimeout(failsafe);
        showAll();
      }
    </script>
  </body>
</html>
