---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RoofrEstimator from '../components/RoofrEstimator.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import Faq from '../components/Faq.astro';
import { site, roofr } from '../data/site.ts';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Instant Roof Quote', href: '/instant-roof-quote' },
];

const faqs = [
  {
    q: 'How does the instant roof quote work?',
    a: 'Enter your address and the estimator pulls satellite imagery of your property, measures your roof, and returns real pricing for the roofing systems we install — in about 60 seconds. You pick the system you want and see what it costs on your specific roof, before anyone calls you.',
  },
  {
    q: 'Is the instant estimate accurate?',
    a: 'It is an honest, measurement-based price — not a guess, and not a contract. Satellite measurement on a straightforward gable or hip roof typically comes within a couple of percent of a tape measure on the deck. What it cannot see is the condition of your decking, your attic ventilation, and how your chimney and skylights are flashed. Those are checked on the free on-roof inspection before we write a firm, line-itemed proposal.',
  },
  {
    q: 'Do I have to talk to a salesperson to get the price?',
    a: 'No. That is the entire point of the tool. You get the number on screen, on your own time. If you want to move forward you can book from inside the estimator, and if you do not, nobody shows up at your door.',
  },
  {
    q: 'Which roofing systems can I price?',
    a: 'The estimator prices our asphalt shingle systems, which is what the large majority of Pittsburgh homes need. If you want standing seam metal, exposed fastener metal, TPO or EPDM priced specifically, call (412) 438-8364 — those systems depend on details the estimator does not ask about, so we quote them directly.',
  },
  {
    q: 'What is included in the price?',
    a: 'Tear-off and disposal of your existing roofing, the complete new roofing system, underlayment, flashing, ventilation, cleanup and haul-off. It does not assume replacement of rotted decking, chimney rebuilds, skylight replacement or structural repairs — those are found on inspection and priced separately so nothing is buried in a lump sum.',
  },
  {
    q: 'What if my home is outside your service area?',
    a: 'Anywhere within about an hour of Pittsburgh — Allegheny, Washington and Butler counties, with our shop in the South Hills. If you are outside it we will tell you honestly rather than driving out and quoting a price inflated by travel. Call (412) 438-8364 and we will point you somewhere reputable.',
  },
  {
    q: 'What happens to my information?',
    a: 'The estimator is operated by Roofr, our roofing software provider, and your details go straight into our own Roofr account so we can follow up. We do not sell your information to lead brokers, and you will not be handed off to three other contractors.',
  },
];

const schema = [
  {
    '@type': 'WebApplication',
    name: 'Top Dog Exteriors Instant Roof Quote',
    url: `${site.domain}/instant-roof-quote`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any modern web browser',
    description:
      'Free instant roof replacement estimate for Greater Pittsburgh homeowners. Enter your address and see real satellite-measured pricing in about 60 seconds — no salesperson, no phone call.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    provider: { '@id': `${site.domain}/#organization` },
  },
];
---

<Base
  title="Instant Roof Quote Pittsburgh PA | Free 60-Second Estimate"
  description="Free instant roof estimate for your Pittsburgh home in about 60 seconds. Satellite-measured pricing from an Owens Corning Preferred Contractor. No salesperson."
  canonical="/instant-roof-quote"
  breadcrumbs={breadcrumbs}
  schema={schema}
  stickyCta={false}
>
  <!-- ══ HERO + TOOL ═══════════════════════════════════════════════════ -->
  <section class="irq-hero texture-diagonal">
    <div class="container">
      <div class="irq-hero__copy">
        <span class="eyebrow">Free · No obligation · 60 seconds</span>
        <h1>Your Roof Price. Right Now. Without Talking to Anybody.</h1>
        <p class="lede">
          Enter your address and our estimator measures your roof from satellite imagery, then
          shows you real Greater Pittsburgh pricing — before anyone calls you, and before anyone
          knocks on your door.
        </p>
        <ul class="irq-hero__list">
          <li><Icon name="satellite" size={19} /> Measured from satellite imagery of your address</li>
          <li><Icon name="ruler" size={19} /> Real pricing on the systems we actually install</li>
          <li><Icon name="shield-check" size={19} /> Priced by an Owens Corning Preferred Contractor</li>
          <li><Icon name="check-circle" size={19} /> Book the free on-roof inspection only if you want to</li>
        </ul>
        <p class="irq-hero__phone">
          Rather just talk? <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
        </p>
      </div>

      <div class="irq-hero__tool">
        <RoofrEstimator />
      </div>
    </div>
  </section>

  <!-- ══ HOW IT WORKS ══════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">How it works</span>
        <h2 id="how-heading">Price First. Salesperson Never.</h2>
        <p class="lede" style="margin-inline:auto">
          The industry norm is to hold the number hostage until a rep has been in your living
          room for three hours. We think that is backwards.
        </p>
      </div>
      <ol class="how">
        <li>
          <span class="how__num">01</span>
          <h3>Enter your address</h3>
          <p>The estimator finds your property and measures the roof from aerial imagery — area, pitch and facets.</p>
        </li>
        <li>
          <span class="how__num">02</span>
          <h3>Pick your system</h3>
          <p>Choose the shingle line and colour you want and watch the price update for your actual roof.</p>
        </li>
        <li>
          <span class="how__num">03</span>
          <h3>See your price</h3>
          <p>A real number, on screen, in about a minute. Save it, print it, or compare it against other quotes.</p>
        </li>
        <li>
          <span class="how__num">04</span>
          <h3>Book if you want to</h3>
          <p>Schedule the free on-roof inspection right inside the tool — or close the tab and nobody chases you.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ══ WHAT THE INSPECTION ADDS ══════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="insp-heading">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">The next step</span>
        <h2 id="insp-heading">What the Free On-Roof Inspection Adds</h2>
        <p class="lede" style="margin-inline:auto">
          Satellite measurement is genuinely accurate on area and pitch. These are the five
          things nobody can determine from imagery — and all five move the price.
        </p>
      </div>
      <ul class="insp">
        <li><h3>Decking condition</h3><p>Soft or delaminated sheathing has to be replaced. We price it per sheet so it is never a surprise line item.</p></li>
        <li><h3>Ventilation</h3><p>Under-ventilated attics cook shingles from below and void warranties. We measure intake and exhaust.</p></li>
        <li><h3>Flashing details</h3><p>Chimneys, skylights, sidewalls and valleys. Most leaks are flashing failures, not shingle failures.</p></li>
        <li><h3>Layer count</h3><p>We confirm what is actually up there. Two layers roughly doubles tear-off and disposal cost.</p></li>
        <li><h3>Access and staging</h3><p>Steep pitch, tight lots and landscaping change labor and property-protection requirements.</p></li>
      </ul>
    </div>
  </section>

  <ReviewsSection service="roofing" heading="Roofing Customers on Working With Us" limit={3} variant="light" />

  <Faq items={faqs} heading="Instant Roof Quote — Questions" id="faq-irq" />

  <!-- ══ CLOSING CTA ═══════════════════════════════════════════════════ -->
  <section class="section section--dark" aria-labelledby="irq-cta">
    <div class="container center">
      <span class="eyebrow">Ready when you are</span>
      <h2 id="irq-cta">Get Your Number in About a Minute</h2>
      <p class="lede" style="margin-inline:auto">
        Free, no obligation, and no salesperson attached to it.
      </p>
      <div class="btn-row" style="justify-content:center;margin-top:var(--sp-6)">
        <a href="#main" class="btn btn--primary btn--lg">
          <Icon name="calculator" size={20} /> Back to the Estimator
        </a>
        <a
          href={roofr.estimatorUrl}
          class="btn btn--ghost-light btn--lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in a New Tab
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .irq-hero {
    background:
      radial-gradient(ellipse 80% 60% at 8% 0%, rgba(56, 182, 255, 0.3), transparent 60%),
      linear-gradient(155deg, var(--steel-900), var(--n-900) 58%, var(--n-950));
    color: var(--n-300);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .irq-hero .container {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: var(--sp-8);
    align-items: start;
  }
  .irq-hero h1 { color: #fff; max-width: 15ch; }
  .irq-hero .eyebrow { color: var(--brand-400); }
  .irq-hero .lede { margin-top: var(--sp-5); color: var(--n-300); }

  .irq-hero__list {
    list-style: none;
    margin: var(--sp-6) 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .irq-hero__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--n-300);
  }
  .irq-hero__list svg { color: var(--brand-400); flex: none; margin-top: 1px; }

  .irq-hero__phone { margin-top: var(--sp-6); font-size: var(--fs-sm); color: var(--n-400); }
  .irq-hero__phone a {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #fff;
    text-decoration: none;
  }
  .irq-hero__phone a:hover { color: var(--brand-400); }

  .irq-hero__tool { position: sticky; top: calc(var(--header-h) + 1rem); }

  @media (max-width: 1060px) {
    .irq-hero .container { grid-template-columns: 1fr; }
    .irq-hero__tool { position: static; }
    .irq-hero h1 { max-width: 20ch; }
  }

  /* ── How it works ─────────────────────────────────────────────────── */
  .how {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: var(--sp-5);
  }
  .how li {
    padding: var(--sp-6);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .how__num {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--brand-600);
    line-height: 1;
    margin-bottom: var(--sp-3);
  }
  .how h3 { font-size: var(--fs-base); margin-bottom: var(--sp-2); }
  .how p { font-size: 0.86rem; line-height: 1.62; color: var(--text-muted); }

  /* ── Inspection list ──────────────────────────────────────────────── */
  .insp {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: var(--sp-4);
  }
  .insp li {
    padding: var(--sp-5);
    background: #fff;
    border: 1px solid var(--border);
    border-left: 4px solid var(--brand-400);
    border-radius: var(--radius);
  }
  .insp h3 { font-size: var(--fs-base); margin-bottom: var(--sp-2); }
  .insp p { font-size: 0.85rem; line-height: 1.6; color: var(--text-muted); }
</style>
