---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site.ts';
import { verifiedReviews, ratingSummary, reviewCount } from '../data/reviews.ts';
import { allServices } from '../data/services.ts';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Reviews', href: '/reviews' },
];

/* Filter chips are built from the services that actually have reviews, so the
   UI can never offer a filter that returns an empty list. */
const tagged = new Set(verifiedReviews.map((r) => r.service).filter(Boolean));
const filters = allServices.filter((s) => tagged.has(s.slug));

const schema = [
  {
    '@type': 'ItemList',
    name: 'Top Dog Exteriors customer reviews',
    numberOfItems: reviewCount,
    itemListElement: verifiedReviews.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Review',
        reviewBody: r.quote,
        author: { '@type': 'Person', name: r.author },
        reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5, worstRating: 1 },
        itemReviewed: { '@id': `${site.domain}/#organization` },
        publisher: { '@type': 'Organization', name: r.source },
      },
    })),
  },
];
---

<Base
  title="Reviews | 5★ Google & Facebook, A Rating BBB | Top Dog"
  description="Verified customer reviews for Top Dog Exteriors in Bethel Park, PA. 5.0 on Google, 100% recommended on Facebook, and an A rating with the BBB."
  canonical="/reviews"
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <PageHero
    eyebrow="Reviews"
    title="Reviewed by the Neighbors, Not by Us"
    lede={`5.0 on Google, 100% recommended on Facebook, and an A rating with the Better Business Bureau. Every one of the ${reviewCount} reviews below is reproduced exactly as the customer wrote it, and every platform links straight to the live listing so you can check for yourself.`}
    breadcrumbs={breadcrumbs}
    align="center"
  />

  <!-- ══ PLATFORM RATINGS ══════════════════════════════════════════════ -->
  <section class="section section--tight section--alt">
    <div class="container">
      <ul class="platforms">
        {
          ratingSummary.platforms.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="platform">
                <span class="platform__name">{p.source}</span>
                <span class="platform__score">{p.display}</span>
                <span class="platform__label">{p.label}</span>
                {p.rating !== null ? (
                  <Stars rating={p.rating} size={18} label={`${p.display} ${p.label} on ${p.source}`} />
                ) : (
                  <span class="platform__grade" aria-hidden="true">
                    <Icon name="award" size={20} />
                  </span>
                )}
                {p.note && <span class="platform__note">{p.note}</span>}
                <span class="platform__link">
                  View on {p.source} <Icon name="arrow_right" size={14} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══ ALL REVIEWS ═══════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="all-reviews-heading">
    <div class="container">
      <h2 id="all-reviews-heading" class="sr-only">All customer reviews</h2>

      <div class="filters" data-filters>
        <span class="filters__label" id="filter-label">Filter by service</span>
        <div class="filters__row" role="group" aria-labelledby="filter-label">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">
            All <span class="chip__count">{reviewCount}</span>
          </button>
          {
            filters.map((s) => (
              <button type="button" class="chip" data-filter={s.slug} aria-pressed="false">
                {s.navLabel}
                <span class="chip__count">
                  {verifiedReviews.filter((r) => r.service === s.slug).length}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <ul class="rlist" data-review-list>
        {
          verifiedReviews.map((r) => (
            <li class="rcard" data-service={r.service ?? 'general'}>
              <div class="rcard__top">
                <Stars rating={r.rating} size={17} />
                <span class="rcard__source">{r.source}</span>
              </div>
              <blockquote class="rcard__quote">
                {r.quote}{r.truncated && <span class="rcard__ellipsis">…</span>}
              </blockquote>
              <footer class="rcard__foot">
                <cite>{r.author}</cite>
                <span class="rcard__meta">
                  {r.date}
                  {r.alsoOn && r.alsoOn.length > 0 && <> · also posted on {r.alsoOn.join(', ')}</>}
                </span>
              </footer>
            </li>
          ))
        }
      </ul>

      <p class="rnone" data-no-results hidden>No reviews tagged with that service yet.</p>

      <!-- Honest framing about what is and is not here. -->
      <div class="rnote">
        <Icon name="shield-check" size={22} />
        <div>
          <h3>How this page works</h3>
          <p>
            Every review is published word for word, including the typos. Where a platform cut a
            review off with a "…&nbsp;More" link, we left it cut off rather than finishing the
            sentence ourselves — click through to the platform to read the rest.
          </p>
          <p>
            Plenty of customers posted the same review to two or three platforms. Each person
            appears here <strong>once</strong>, with the other platforms noted underneath, so the
            count is people rather than postings.
          </p>
          <p>
            Check any of it yourself on
            <a href={site.social.google} target="_blank" rel="noopener noreferrer">Google</a>,
            <a href={site.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a> or
            <a href={site.social.bbb} target="_blank" rel="noopener noreferrer">the BBB</a>.
          </p>
        </div>
      </div>

      <div class="ractions">
        <a href={site.social.google} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
          <Icon name="star" size={18} /> Leave a Google review
        </a>
        <a href={site.social.facebook} class="btn btn--outline" target="_blank" rel="noopener noreferrer">
          <Icon name="facebook" size={18} /> Recommend us on Facebook
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Want to Be the Next One?"
    body="Free estimate, honest number, and work we are happy to have reviewed publicly."
  />
</Base>

<style>
  /* ── Platform cards ───────────────────────────────────────────────── */
  .platforms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--sp-4);
  }
  .platform {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    padding: var(--sp-6);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
    text-decoration: none;
    color: var(--text);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--t), box-shadow var(--t), transform var(--t-fast);
  }
  .platform:hover {
    border-color: var(--brand-400);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    color: var(--text);
  }
  .platform__name {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .platform__score {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--n-900);
  }
  .platform__label { font-size: 0.82rem; color: var(--text-muted); }
  .platform__grade { color: var(--brand-600); }
  .platform__note { font-size: 0.78rem; color: var(--text-subtle); }
  .platform__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--brand-700);
  }

  /* ── Filters ──────────────────────────────────────────────────────── */
  .filters { margin-bottom: var(--sp-6); }
  .filters__label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: var(--sp-3);
  }
  .filters__row { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.5rem 0.95rem;
    background: #fff;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--n-700);
    transition: all var(--t-fast);
  }
  .chip:hover { border-color: var(--brand-400); }
  .chip[aria-pressed='true'] {
    background: var(--brand-400);
    border-color: var(--brand-400);
    color: var(--brand-ink);
  }
  .chip__count {
    font-size: 0.74rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--n-100);
    color: var(--n-700);
  }
  .chip[aria-pressed='true'] .chip__count {
    background: rgba(4, 40, 60, 0.16);
    color: var(--brand-ink);
  }

  /* ── Review cards ─────────────────────────────────────────────────── */
  .rlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: var(--sp-4);
    align-items: start;
  }
  .rcard {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background: #fff;
    border: 1px solid var(--border);
    border-left: 4px solid var(--brand-400);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .rcard[hidden] { display: none; }
  .rcard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .rcard__source {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .rcard__quote {
    margin: 0;
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--n-800);
  }
  .rcard__quote::before { content: '“'; }
  .rcard__quote::after { content: '”'; }
  .rcard__ellipsis { color: var(--text-subtle); }
  .rcard__foot { padding-top: var(--sp-3); border-top: 1px solid var(--border); }
  .rcard__foot cite {
    display: block;
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .rcard__meta { display: block; margin-top: 2px; font-size: 0.76rem; color: var(--text-subtle); }

  .rnone { text-align: center; color: var(--text-muted); padding: var(--sp-8) 0; }
  .rnone[hidden] { display: none; }

  /* ── Note ─────────────────────────────────────────────────────────── */
  .rnote {
    display: flex;
    gap: var(--sp-4);
    max-width: 840px;
    margin: var(--sp-8) auto 0;
    padding: var(--sp-6);
    background: var(--n-50);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .rnote svg { color: var(--success-700); flex: none; margin-top: 3px; }
  .rnote h3 { font-size: var(--fs-base); margin-bottom: var(--sp-2); }
  .rnote p { font-size: var(--fs-sm); line-height: 1.65; color: var(--text-muted); }
  .rnote p + p { margin-top: var(--sp-3); }
  .rnote a { font-weight: 600; }

  .ractions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }
</style>

<script>
  // Client-side filtering. Progressive enhancement: with JS off the chips are
  // simply inert and every review stays visible, which is the correct fallback.
  const wrap = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-review-list]');
  const empty = document.querySelector<HTMLElement>('[data-no-results]');

  if (wrap && list) {
    const chips = Array.from(wrap.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-service]'));

    wrap.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!chip) return;

      const filter = chip.dataset.filter!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));

      let visible = 0;
      cards.forEach((card) => {
        const match = filter === 'all' || card.dataset.service === filter;
        card.hidden = !match;
        if (match) visible++;
      });

      if (empty) empty.hidden = visible > 0;
    });
  }
</script>
